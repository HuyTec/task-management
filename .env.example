# Supply these values through your shell, IDE run configuration, or Docker Compose environment.
# Never commit real secrets.

SPRING_PROFILES_ACTIVE=local
JWT_SECRET=replace-with-a-base64-encoded-random-32-byte-secret
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/taskmanagement_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres123
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
# Set true only for the first startup against a verified pre-Flyway database.
FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
APP_COOKIE_SECURE=false
